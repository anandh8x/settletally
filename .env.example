# Optional comma-separated Arc Testnet RPC failover list.
ARC_RPC_URLS=https://rpc.testnet.arc.io,https://rpc.testnet.arc.network

# Operational request limits.
ARC_RPC_BATCH_SIZE=250
MAX_BLOCK_SPAN=5000
MAX_EXPECTED_RECORDS=2000
MAX_CONCURRENT_SCANS=4
REQUEST_TIMEOUT_SECONDS=45

# Add only separate frontend origins. Same-origin deployments work automatically.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
